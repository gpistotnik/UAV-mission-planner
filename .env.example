# Konfiguracija / Configuration.  Kopiraj v `.env` in prilagodi.

# --- Razvoj / Development ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# --- Dostop iz LAN / hotspota ---
# Dodaj IP, na katerem tece streznik (telefon in laptop se povezeta nanj).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,dron.local,dron,10.0.0.1,192.168.88.252,10.42.0.1
CSRF_TRUSTED_ORIGINS=http://dron.local,http://10.0.0.1,http://192.168.88.252,http://10.42.0.1,http://localhost,http://127.0.0.1

# Captive portal 302 cilj (probe → ta URL). Na AP dnsmasq resolva dron.local.
# UAV_CAPTIVE_REDIRECT_URL=http://dron.local/sl/nadzor/

# --- Podatkovna baza ---
# Privzeto: SQLite v korenu projekta
DATABASE_URL=sqlite:///./db.sqlite3
# PostgreSQL:  pip install -r requirements-postgres.txt
# DATABASE_URL=postgres://user:pass@localhost:5432/missionplanner
# MariaDB:     pip install -r requirements-mariadb.txt
# DATABASE_URL=mysql://user:pass@localhost:3306/missionplanner

# --- Lokalizacija ---
DJANGO_LANGUAGE_CODE=sl
DJANGO_TIME_ZONE=Europe/Ljubljana

# --- Kontrola letalnika ---
# Ali koncisca za arm / prenos misije / start zahtevajo prijavo.
# Privzeto: obratno od DJANGO_DEBUG (v polju zaprto). Med bench testom
# brez uporabniskega racuna lahko izrecno odpres:
# UAV_REQUIRE_AUTH=False

# --- Logiranje telemetrije ---
# Na Raspberry Pi "auto" poišče natanko en priklopljen, zapisljiv USB ključek.
# Nanj gredo samo podatki letov: telemetrija, meta/plan, slike in analize.
# SQLite ter Wi-Fi runtime stanje ostaneta lokalna.
# Brez medija aplikacija deluje, zapisovanje pa je izklopljeno in GUI javi napako.
# Za servisno obnovo lahko namesto "auto" podaš absolutno pot do
# aplikacijskega korena na že priklopljenem ključku.
# UAV_STORAGE_ROOT=auto
# Kdaj se zapis začne in konča: takeoff (privzeto) | arm | off
UAV_LOG_TRIGGER=takeoff

# --- Samodejna povezava s Pixhawkom ---
# Na dronu VEDNO vklopi (tudi ce DJANGO_DEBUG=True med benchom):
UAV_AUTOCONNECT=True
# "auto" najprej USB (ttyACM*/ttyUSB*/COM*), nato UART (/dev/serial0).
# Na RPi z drone-mavlink-mux.service (priporočeno):
#   UAV_SERIAL_DEVICE=udp:127.0.0.1:14550
# Mux drži fizični port (ttyACM0/serial0) in forwarda tudi na 14551
# za camera_trigger. Brez muxa: neposredno /dev/ttyACM0 ali auto.
# Za SITL: udp:127.0.0.1:14551
UAV_SERIAL_DEVICE=udp:127.0.0.1:14550
UAV_SERIAL_BAUD=115200

# --- Kamera ---
# "auto" = http://<host>:8090/stream.mjpg
DRONE_CAMERA_URL=auto

# --- Preklop Wi-Fi prek fizičnega stikala (GPIO19) ---
# Mapa za deljeno stanje med scripts/wifi_gpio_switch.py in tem strežnikom.
# Privzeto <repo>/run (mora ustrezati --runtime-dir demona).
# UAV_RUNTIME_DIR=/home/dron/mission_planner/run
# Sekund odloga preklopa, če je nekdo ravno aktiven v vmesniku.
UAV_NETWORK_GRACE_S=30.0
