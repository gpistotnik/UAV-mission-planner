[Unit]
Description=Drone WiFi captive portal redirector
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dron
Group=dron
WorkingDirectory=/home/dron/mission_planner
# Če teče mission-planner na :80, ta servis NE sme biti aktiven
# (Conflicts). Captive 302 potem dela Django middleware (core.captive)
# na http://dron.local/sl/nadzor/.
ExecStart=/usr/bin/python3 /home/dron/mission_planner/scripts/captive_portal.py \
    --port 80 --target http://dron.local/sl/nadzor/
# Brez te zmogljivosti porta <1024 ne moremo odpreti kot ne-root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
